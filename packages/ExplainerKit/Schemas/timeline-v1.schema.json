{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:explainerkit:timeline:1",
  "title": "ExplainerKit final media timeline, version 1",
  "type": "object",
  "required": ["schema", "title", "width", "height", "fps", "duration_ns", "chapters", "lessons", "steps", "actions", "frames", "narration", "takes"],
  "properties": {
    "schema": {"const": 1}, "title": {"type": "string"},
    "width": {"type": "integer", "minimum": 2, "multipleOf": 2},
    "height": {"type": "integer", "minimum": 2, "multipleOf": 2},
    "fps": {"type": "integer", "minimum": 1, "maximum": 60},
    "duration_ns": {"type": "integer", "minimum": 1},
    "chapters": {"type": "array", "items": {"$ref": "#/$defs/interval"}},
    "lessons": {"type": "array", "items": {"$ref": "#/$defs/interval"}},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interval"}},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/interval"}},
    "frames": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["pts_ns", "source_pts_ns", "path", "sha256", "lesson"],
      "properties": {"pts_ns": {"type": "integer", "minimum": 0}, "source_pts_ns": {"type": "integer", "minimum": 0},
                     "path": {"type": "string"}, "sha256": {"type": "string"}, "lesson": {"type": "string"}}
    }},
    "narration": {"type": "array", "items": {
      "type": "object", "required": ["id", "path", "start_ns", "duration_ns", "sha256", "text"],
      "properties": {"id": {"type": "string"}, "path": {"type": "string"}, "text": {"type": "string"},
                     "start_ns": {"type": "integer", "minimum": 0}, "duration_ns": {"type": "integer", "minimum": 1},
                     "sha256": {"type": "string"}}
    }},
    "takes": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["manifest", "start_ns", "end_ns"],
      "properties": {"manifest": {"type": "string"}, "start_ns": {"type": "integer", "minimum": 0},
                     "end_ns": {"type": "integer", "minimum": 1}}
    }}
  },
  "$defs": {
    "interval": {
      "type": "object", "required": ["id", "start_ns", "end_ns"],
      "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string"},
                     "text": {"type": "string"}, "lesson": {"type": "string"}, "chapter": {"type": "string"},
                     "start_ns": {"type": "integer", "minimum": 0}, "end_ns": {"type": "integer", "minimum": 1}}
    }
  },
  "$comment": "All relative times are integer nanoseconds. end_ns is exclusive. Semantic validation checks coverage, ordering, duration, identity uniqueness and narration fit. The player embeds a subset omitting large frame/action/audio-source arrays."
}
