{
  "id": "view",
  "title": "Sort and columns",
  "order": 6,
  "duration": 45,
  "chapter": "basics",
  "summary": "Sort by name, size or date, show more columns, use one pane, and resize the panes.",
  "covers": {
    "commands": [
      "sort_by_name",
      "sort_by_size",
      "sort_by_date",
      "toggle_permissions_column",
      "toggle_owner_group_column",
      "toggle_single_panel_mode"
    ],
    "anchors": [
      "panes.divider"
    ]
  },
  "steps": [
    {
      "open_tabs": {
        "left": "{home}/camera",
        "right": "{home}/music/Night Drive",
        "focus": "left"
      }
    },
    {
      "chapter": "Basics"
    },
    {
      "caption": "Sort by size",
      "sub": "Click a column header, or use View › Sort By. Again reverses the order"
    },
    {
      "keys": [
        "@sort_by_size"
      ]
    },
    {
      "wait": {
        "sort": {
          "side": "left",
          "is": "size"
        }
      }
    },
    {
      "pause": 1200
    },
    {
      "keys": [
        "@sort_by_size"
      ]
    },
    {
      "wait": {
        "sort": {
          "side": "left",
          "is": "size_desc"
        }
      }
    },
    {
      "pause": 1200
    },
    {
      "caption": "Or by date",
      "sub": ""
    },
    {
      "keys": [
        "@sort_by_date"
      ]
    },
    {
      "wait": {
        "sort": {
          "side": "left",
          "is": "date"
        }
      }
    },
    {
      "pause": 1200
    },
    {
      "keys": [
        "@sort_by_name"
      ]
    },
    {
      "wait": {
        "sort": {
          "side": "left",
          "is": "name"
        }
      }
    },
    {
      "caption": "More columns",
      "sub": "Show permissions and owner:group, or right-click a column header"
    },
    {
      "keys": [
        "@toggle_permissions_column"
      ]
    },
    {
      "wait": {
        "columns": {
          "side": "left",
          "permissions": true
        }
      }
    },
    {
      "keys": [
        "@toggle_owner_group_column"
      ]
    },
    {
      "wait": {
        "columns": {
          "side": "left",
          "owner": true
        }
      }
    },
    {
      "pause": 1800
    },
    {
      "keys": [
        "@toggle_permissions_column"
      ]
    },
    {
      "keys": [
        "@toggle_owner_group_column"
      ]
    },
    {
      "wait": {
        "columns": {
          "side": "left",
          "permissions": false,
          "owner": false
        }
      }
    },
    {
      "caption": "One pane, full width",
      "sub": "Single Pane shows only the focused pane. Again brings both back"
    },
    {
      "keys": [
        "@toggle_single_panel_mode"
      ]
    },
    {
      "wait": {
        "single": true
      }
    },
    {
      "pause": 1800
    },
    {
      "keys": [
        "@toggle_single_panel_mode"
      ]
    },
    {
      "wait": {
        "single": false
      }
    },
    {
      "caption": "Resize the panes",
      "sub": "Drag the line between them"
    },
    {
      "highlight": "panes.divider",
      "hold": 2000
    },
    {
      "unhighlight": true
    },
    {
      "uncaption": true
    }
  ]
}
