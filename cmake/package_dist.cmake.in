if(NOT DEFINED FC_BIN)
  message(FATAL_ERROR "FC_BIN is required")
endif()
if(NOT DEFINED FC_DIST_ROOT OR NOT DEFINED FC_DIST_NAME)
  message(FATAL_ERROR "FC_DIST_ROOT and FC_DIST_NAME are required")
endif()

set(_stage "${FC_DIST_ROOT}/${FC_DIST_NAME}")
set(_tar "${FC_DIST_ROOT}/${FC_DIST_NAME}.tar.gz")

file(REMOVE_RECURSE "${_stage}")
file(MAKE_DIRECTORY "${_stage}/bin")
file(COPY "${FC_BIN}" DESTINATION "${_stage}/bin")
file(COPY "@CMAKE_CURRENT_SOURCE_DIR@/licenses" DESTINATION "${_stage}/share")
file(MAKE_DIRECTORY "${_stage}/share/licenses/file-commander" "${_stage}/share/file-commander")
file(COPY "@CMAKE_CURRENT_SOURCE_DIR@/LICENSE" DESTINATION "${_stage}/share/licenses/file-commander")
file(COPY "@CMAKE_CURRENT_SOURCE_DIR@/README.md" DESTINATION "${_stage}")
file(COPY "@CMAKE_CURRENT_SOURCE_DIR@/THIRD_PARTY_NOTICES.md"
          "@CMAKE_CURRENT_SOURCE_DIR@/dependencies.json"
     DESTINATION "${_stage}/share/file-commander")

if(DEFINED FC_DIST_FRESH AND EXISTS "${FC_DIST_FRESH}")
  file(COPY "${FC_DIST_FRESH}" DESTINATION "${_stage}/bin")
  file(MAKE_DIRECTORY "${_stage}/share/licenses/fresh")
  file(COPY "@FC_FRESH_SOURCE_DIR@/LICENSE" DESTINATION "${_stage}/share/licenses/fresh")
  file(MAKE_DIRECTORY "${_stage}/share/file-commander")
  file(COPY "@CMAKE_CURRENT_SOURCE_DIR@/dependencies.json"
            "@CMAKE_CURRENT_SOURCE_DIR@/dependencies/fresh-fc.bundle"
            "@CMAKE_CURRENT_SOURCE_DIR@/dependencies/README.md"
       DESTINATION "${_stage}/share/file-commander")
endif()

if(DEFINED FC_DIST_ARCHIVE AND EXISTS "${FC_DIST_ARCHIVE}")
  file(COPY "${FC_DIST_ARCHIVE}" DESTINATION "${_stage}/bin")
endif()

execute_process(
  COMMAND "${CMAKE_COMMAND}" -E tar "cfvz" "${_tar}" --format=gnutar "${FC_DIST_NAME}"
  WORKING_DIRECTORY "${FC_DIST_ROOT}"
  RESULT_VARIABLE _tar_rc
)
if(NOT _tar_rc EQUAL 0)
  message(FATAL_ERROR "Failed to create tarball: ${_tar}")
endif()

message(STATUS "Packaged distribution: ${_tar}")
