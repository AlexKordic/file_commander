{
  "title": "File Commander",
  "terminal": {"min_cols": 120, "min_rows": 34},
  "prompt": "$ ",
  "pace": {"key_gap_ms": 450, "type_ms": [70, 140], "seed": 7},
  "scenes": [
    {
      "id": "opening",
      "title": "Two panels, keyboard first",
      "steps": [
        {"clear": true},
        {"shell": "cd {home}"},
        {"shell": "fc . photos/2026"},
        {"launch": {"args": ["{home}", "{home}/photos/2026"]}},
        {"wait": "/camera"},
        {"caption": "File Commander", "sub": "A two-panel file manager for the terminal", "hold": 2500},
        {"keys": ["Down"]},
        {"highlight": {"text": "/camera", "half": "left"}},
        {"keys": ["Enter"]},
        {"wait": "IMG_2041"},
        {"caption": "Type to filter", "sub": "Only matching names stay in the list"},
        {"type": "MOV"},
        {"wait_gone": "IMG_2041"},
        {"pause": 1200},
        {"keys": ["Backspace", "Backspace", "Backspace"], "gap": 180},
        {"wait": "IMG_2050"},
        {"caption": "Select by pattern", "sub": "+ selects every name that matches"},
        {"keys": ["+"]},
        {"wait": "Select by Glob"},
        {"type": "*.jpg"},
        {"pause": 400},
        {"keys": ["Enter"]},
        {"wait_gone": "Select by Glob"},
        {"wait": "Sel 24/"},
        {"highlight": {"text": "Sel 24/", "half": "left"}, "hold": 1800}
      ]
    },
    {
      "id": "background_copy",
      "title": "Copies run in the background",
      "steps": [
        {"caption": "Copy with F5", "sub": "The destination is the other panel"},
        {"keys": ["F5"]},
        {"wait": "Copy 24 selected items"},
        {"highlight": {"text": "TO: \\S+"}, "hold": 1500},
        {"keys": ["F5"]},
        {"wait": "\\[COPY"},
        {"caption": "The UI never waits", "sub": "Keep browsing while the copy runs"},
        {"highlight": {"text": "\\[COPY"}, "hold": 1200},
        {"keys": ["?"]},
        {"wait": "/projects"},
        {"keys": ["Down"]},
        {"keys": ["Enter"]},
        {"wait": "Night Drive"},
        {"pause": 900},
        {"keys": ["?"]},
        {"wait": "/projects"},
        {"wait_gone": "\\[COPY", "timeout": 60},
        {"wait": "IMG_2064", "timeout": 4, "fallback": ["Tab", "Ctrl+R", "Tab"]},
        {"caption": "Done", "sub": "24 photos copied while you kept working"},
        {"highlight": {"text": "IMG_2064", "half": "right"}, "hold": 2000}
      ]
    },
    {
      "id": "ssh",
      "title": "SSH is just another panel",
      "steps": [
        {"caption": "SSH is just another panel", "sub": "Any host from your ~/.ssh/config"},
        {"keys": ["Tab", "F1"]},
        {"wait": "Command Palette"},
        {"type": "connect"},
        {"wait": "Command Palette \\[1\\]"},
        {"highlight": {"text": "Connect SSH"}, "hold": 700},
        {"keys": ["Enter"]},
        {"wait": "Host alias or user@host"},
        {"type": "{ssh_host}"},
        {"keys": ["Down", "Delete"]},
        {"type": "{server}"},
        {"pause": 300},
        {"click": {"text": "Connect(?=\\s+Cancel)"}},
        {"wait": "ssh://{ssh_host}", "timeout": 30},
        {"wait": "robots\\.txt", "timeout": 30},
        {"highlight": {"text": "ssh://{ssh_host}\\S*", "half": "right"}, "hold": 1800},
        {"caption": "Upload the website", "sub": "Copy between local and remote tabs"},
        {"click": {"text": "/projects", "half": "left"}},
        {"pause": 300},
        {"keys": ["Enter"]},
        {"wait": "/website"},
        {"type": "web"},
        {"keys": ["Enter"]},
        {"wait": "home/projects/website"},
        {"keys": ["Ctrl+A", "F5"]},
        {"wait": "Copy 4 selected items"},
        {"highlight": {"text": "TO: \\S+"}, "hold": 1500},
        {"keys": ["F5"]},
        {"wait_gone": "Copy 4 selected items"},
        {"wait_gone": "\\[COPY", "timeout": 30},
        {"wait": "║[^\\n]*style\\.css", "timeout": 8, "fallback": ["Tab", "Ctrl+R", "Tab"]},
        {"caption": "Uploaded", "sub": "Every file is checked with SHA-256"},
        {"highlight": {"text": "style\\.css", "half": "right"}, "hold": 2000},
        {"keys": ["?", "?"]},
        {"wait": "/camera"}
      ]
    },
    {
      "id": "editor",
      "title": "An editor one key away",
      "steps": [
        {"caption": "Edit with F4", "sub": "Files open in a built-in editor session"},
        {"type": "proj"},
        {"keys": ["Enter"]},
        {"wait": "/website"},
        {"type": "web"},
        {"keys": ["Enter"]},
        {"wait": "home/projects/website"},
        {"type": "index"},
        {"pause": 500},
        {"keys": ["F4"]},
        {"wait": "Ln \\d+, Col \\d+", "timeout": 20},
        {"pause": 800},
        {"keys": ["Ctrl+End"]},
        {"type": "<p>New photos every week.</p>"},
        {"pause": 800},
        {"caption": "F10 switches back", "sub": "The editor keeps running in the background"},
        {"keys": ["F10"]},
        {"wait": "Tabs  1:"},
        {"pause": 1500},
        {"keys": ["F10"]},
        {"wait": "New photos every week"},
        {"caption": "Unsaved text is still there", "sub": "Tabs and changes live in the editor, even across restarts"},
        {"highlight": {"text": "<p>New photos every week.</p>"}, "hold": 2000},
        {"keys": ["Ctrl+S"]},
        {"wait_gone": "index\\.html\\*"},
        {"keys": ["F10"]},
        {"wait": "Tabs  1:"},
        {"keys": ["Backspace", "Backspace", "Backspace", "Backspace", "Backspace"], "gap": 120},
        {"keys": ["?", "?"]},
        {"wait": "/camera"}
      ]
    },
    {
      "id": "quick_tour",
      "title": "Bookmarks, archives, find, layout",
      "steps": [
        {"caption": "Bookmarks", "sub": "Ctrl+B jumps to saved places"},
        {"keys": ["Ctrl+B"]},
        {"wait": "Bookmarks \\[3\\]"},
        {"keys": ["Down"]},
        {"pause": 500},
        {"keys": ["Enter"]},
        {"wait": "home/photos/2026 "},
        {"pause": 1200},
        {"keys": ["?", "?"]},
        {"wait": "/camera"},
        {"caption": "7z archives open like folders", "sub": "Browse and copy files out of them"},
        {"type": "2025"},
        {"pause": 400},
        {"keys": ["Enter"]},
        {"wait": "app\\.js"},
        {"pause": 1800},
        {"keys": ["?"]},
        {"wait": "/camera"},
        {"caption": "Find files", "sub": "F3 searches names below any folder"},
        {"keys": ["F3"]},
        {"wait": "Mask:"},
        {"type": "*.md"},
        {"keys": ["Enter"]},
        {"wait": "Matches:[1-9]"},
        {"highlight": {"text": "\\S+/notes/ideas\\.md"}, "hold": 1800},
        {"keys": ["Esc"]},
        {"wait_gone": "Mask:"},
        {"caption": "Mouse works too", "sub": "Click a column header to sort"},
        {"click": {"text": "Size", "half": "left"}},
        {"pause": 1500},
        {"click": {"text": "Name", "half": "left"}},
        {"pause": 800},
        {"click": {"text": "/music", "half": "left"}},
        {"pause": 600},
        {"caption": "One panel, full width", "sub": "Ctrl+O toggles the layout"},
        {"keys": ["Ctrl+O"]},
        {"wait": "Hidden Right"},
        {"pause": 1500},
        {"keys": ["Ctrl+O"]},
        {"wait_gone": "Hidden Right"}
      ]
    },
    {
      "id": "job_control",
      "title": "Pause and resume any job",
      "steps": [
        {"caption": "Back up the music", "sub": "A large copy into the backup folder"},
        {"type": "backup"},
        {"pause": 400},
        {"keys": ["Ctrl+Right"]},
        {"wait": "home/backup "},
        {"keys": ["Backspace", "Backspace", "Backspace", "Backspace", "Backspace", "Backspace"], "gap": 100},
        {"type": "music"},
        {"keys": ["Enter"]},
        {"wait": "Night Drive"},
        {"keys": ["Ctrl+A", "F5"]},
        {"wait": "Copy 2 selected items"},
        {"keys": ["F5"]},
        {"wait": "\\[COPY"},
        {"pause": 1500},
        {"caption": "Pause and resume any job", "sub": "F9 opens the job list"},
        {"keys": ["F9"]},
        {"wait": "Job History"},
        {"highlight": {"text": "\\[#\\d+\\] COPY.*running"}, "hold": 1200},
        {"keys": ["p"]},
        {"wait": "paused — r: Resume"},
        {"highlight": {"text": "\\[#\\d+\\] COPY.*paused.*"}, "hold": 1800},
        {"keys": ["r"]},
        {"wait": "COPY.*running"},
        {"pause": 1200},
        {"keys": ["Esc"]},
        {"wait_gone": "Job History"},
        {"pause": 2000}
      ]
    },
    {
      "id": "crash_recovery",
      "title": "Transfers survive crashes",
      "steps": [
        {"caption": "Now the worst case", "sub": "FC is killed in the middle of the copy", "hold": 2000},
        {"crash": {"message": "zsh: killed     fc . photos/2026"}},
        {"uncaption": true},
        {"pause": 1200},
        {"shell": "fc"},
        {"launch": {"args": []}},
        {"wait": "Night Drive", "timeout": 20},
        {"caption": "Everything is back", "sub": "Tabs, folders and the interrupted copy", "hold": 1800},
        {"keys": ["F9"]},
        {"wait": "paused — r: Resume"},
        {"highlight": {"text": "\\[#\\d+\\] COPY.*paused.*"}},
        {"caption": "Resume when you are ready", "sub": "Finished files are kept; nothing restarts by itself", "hold": 2200},
        {"keys": ["r"]},
        {"wait": "COPY.*running|COPY.*files\\s+\\S+\\s+\\S+"},
        {"pause": 1200},
        {"keys": ["Esc"]},
        {"wait_gone": "\\[COPY", "timeout": 90},
        {"wait": "Night Drive.*║.*Night Drive", "timeout": 4, "fallback": ["Tab", "Ctrl+R", "Tab"]},
        {"caption": "Backup complete", "sub": "Interrupted, recovered, finished"},
        {"highlight": {"text": "/Night Drive", "half": "right"}, "hold": 2000}
      ]
    },
    {
      "id": "closing",
      "title": "File Commander",
      "steps": [
        {"caption": "File Commander", "sub": "github.com/AlexKordic/file_commander", "hold": 3500},
        {"uncaption": true},
        {"quit": true},
        {"clear": true}
      ]
    }
  ]
}
